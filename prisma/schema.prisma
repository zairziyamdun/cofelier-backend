// Схема БД Cofelier. Модели появляются по этапам (docs/BACKEND.md §4):
// меню — этап 2, пользователи и роли — этап 3, заказы — этап 5.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Импорты без расширения: иначе Jest (ts-jest) не находит ./x.js рядом с x.ts.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  barista
  manager
  admin
}

model User {
  id           Int      @id @default(autoincrement())
  // Хранится в нижнем регистре: вход не зависит от регистра букв.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(client)
  // Отключённый сотрудник не может войти, но его заказы и история остаются.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@map("users")
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  // Стабильный идентификатор для URL и якорей на странице меню.
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("menu_categories")
}

model MenuItem {
  id              Int          @id @default(autoincrement())
  categoryId      Int          @map("category_id")
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  // Объём или вес для подписи: «250 мл», «120 г».
  portion         String?
  // Цена в целых тенге: дробных сумм в меню нет.
  price           Int
  imageUrl        String?      @map("image_url")
  // Стоп-лист: позиция видна в меню, но заказать её нельзя.
  inStopList      Boolean      @default(false) @map("in_stop_list")
  // Удалённая позиция, которая уже есть в заказах: скрыта из меню, но история цела.
  isArchived      Boolean      @default(false) @map("is_archived")
  // Метки, которые ставит менеджер. «Новинка» и «Популярно» считаются сами —
  // menu/menu-badges.ts.
  badges          MenuBadge[]  @default([])
  // До какого момента позиция — «Новинка»; null — не новинка.
  newUntil        DateTime?    @map("new_until")
  // «Популярно» вручную: true — всегда, false — никогда, null — по заказам.
  popularOverride Boolean?     @map("popular_override")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  orderItems      OrderItem[]

  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

// Ручные метки позиции меню.
enum MenuBadge {
  seasonal
  signature
  decaf
}

// Жизненный цикл заказа: переходы — orders/order-status.ts.
enum OrderStatus {
  new
  accepted
  preparing
  ready
  completed
  cancelled
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    OrderStatus @default(new)
  // Сумма в целых тенге — считает сервер по ценам меню на момент заказа.
  total     Int
  comment   String?
  // Когда клиент заберёт заказ; null — «как можно скорее».
  pickupAt  DateTime?   @map("pickup_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  // Копия названия и цены на момент заказа: правка меню не меняет старые заказы.
  name       String
  price      Int
  quantity   Int

  @@index([orderId])
  @@map("order_items")
}
