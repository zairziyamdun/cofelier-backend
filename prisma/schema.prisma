// Схема БД Cofelier. Модели появляются по этапам (docs/BACKEND.md §4):
// меню — этап 2, пользователи и роли — этап 3, заказы — этап 5.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Импорты без расширения: иначе Jest (ts-jest) не находит ./x.js рядом с x.ts.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  barista
  manager
  admin
}

model User {
  id           Int      @id @default(autoincrement())
  // Хранится в нижнем регистре: вход не зависит от регистра букв.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(client)
  // Отключённый сотрудник не может войти, но его заказы и история остаются.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@map("users")
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  // Стабильный идентификатор для URL и якорей на странице меню.
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("menu_categories")
}

model MenuItem {
  id              Int                     @id @default(autoincrement())
  categoryId      Int                     @map("category_id")
  // Для ссылки на товар (/menu?item=raf); при переименовании не меняется.
  slug            String                  @unique
  category        MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  // Объём или вес для подписи: «250 мл», «120 г».
  portion         String?
  // Цена в целых тенге: дробных сумм в меню нет.
  price           Int
  // Стоп-лист: позиция видна в меню, но заказать её нельзя.
  inStopList      Boolean                 @default(false) @map("in_stop_list")
  // Удалённая позиция, которая уже есть в заказах: скрыта из меню, но история цела.
  isArchived      Boolean                 @default(false) @map("is_archived")
  // Метки, которые ставит менеджер. «Новинка» и «Популярно» считаются сами —
  // menu/menu-badges.ts.
  badges          MenuBadge[]             @default([])
  // До какого момента позиция — «Новинка»; null — не новинка.
  newUntil        DateTime?               @map("new_until")
  // «Популярно» вручную: true — всегда, false — никогда, null — по заказам.
  popularOverride Boolean?                @map("popular_override")
  sortOrder       Int                     @default(0) @map("sort_order")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  orderItems      OrderItem[]
  photos          MenuItemPhoto[]
  modifierGroups  MenuItemModifierGroup[]

  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

// Фото позиции: файлы в S3 (<key>-320/800/1600.webp), первое по sortOrder — обложка.
model MenuItemPhoto {
  id         Int      @id @default(autoincrement())
  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  // Общий префикс файлов в хранилище: menu/<itemId>/<uuid>.
  key        String   @unique
  width      Int
  height     Int
  // Прозрачный фон (рендер без фона) — витрина показывает его без рамки.
  hasAlpha   Boolean  @default(false) @map("has_alpha")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([menuItemId, sortOrder])
  @@map("menu_item_photos")
}

// Как выбирают варианты группы добавок: один, несколько или количеством.
enum ModifierGroupKind {
  single
  multiple
  quantity
}

// Группа добавок («Молоко», «Сироп»): заводится один раз, подключается к товарам.
// Правила выбора — menu/modifier-selection.ts.
model ModifierGroup {
  id        Int                     @id @default(autoincrement())
  name      String
  kind      ModifierGroupKind
  // Обязательна: без выбора в этой группе товар не добавить.
  required  Boolean                 @default(false)
  // multiple — сколько вариантов можно выбрать; quantity — сколько штук всего.
  // single — не используется (всегда один). null — без ограничения.
  maxSelect Int?                    @map("max_select")
  sortOrder Int                     @default(0) @map("sort_order")
  options   ModifierOption[]
  items     MenuItemModifierGroup[]
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@map("modifier_groups")
}

model ModifierOption {
  id         Int                 @id @default(autoincrement())
  groupId    Int                 @map("group_id")
  group      ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  // Надбавка к цене товара в целых тенге; 0 — бесплатно.
  priceDelta Int                 @default(0) @map("price_delta")
  // Выбран сразу: «+» в меню добавляет товар с вариантами по умолчанию.
  isDefault  Boolean             @default(false) @map("is_default")
  // Закончилось (овсяное молоко): вариант виден, но выбрать нельзя.
  inStopList Boolean             @default(false) @map("in_stop_list")
  // Подпись к варианту, например объём у размера: «350 мл».
  note       String?
  sortOrder  Int                 @default(0) @map("sort_order")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  orderItems OrderItemModifier[]

  @@index([groupId, sortOrder])
  @@map("modifier_options")
}

// Какие группы добавок у товара и в каком порядке.
model MenuItemModifierGroup {
  menuItemId Int           @map("menu_item_id")
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    Int           @map("group_id")
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0) @map("sort_order")

  @@id([menuItemId, groupId])
  @@map("menu_item_modifier_groups")
}

// Ручные метки позиции меню.
enum MenuBadge {
  seasonal
  signature
  decaf
}

// Жизненный цикл заказа: переходы — orders/order-status.ts.
enum OrderStatus {
  new
  accepted
  preparing
  ready
  completed
  cancelled
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    OrderStatus @default(new)
  // Сумма в целых тенге — считает сервер по ценам меню на момент заказа.
  total     Int
  comment   String?
  // Когда клиент заберёт заказ; null — «как можно скорее».
  pickupAt  DateTime?   @map("pickup_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int                 @map("order_id")
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int                 @map("menu_item_id")
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  // Копия названия и цены на момент заказа: правка меню не меняет старые заказы.
  name       String
  // Цена за штуку вместе с добавками, на момент заказа.
  price      Int
  quantity   Int
  modifiers  OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

// Копия выбранной добавки на момент заказа: правка или удаление добавки в меню
// старые заказы не меняет.
model OrderItemModifier {
  id          Int             @id @default(autoincrement())
  orderItemId Int             @map("order_item_id")
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  // Какой вариант выбрали — чтобы повторить заказ. Вариант удалили из меню —
  // null, а копия названия и цены остаётся.
  optionId    Int?            @map("option_id")
  option      ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  groupName   String          @map("group_name")
  optionName  String          @map("option_name")
  priceDelta  Int             @map("price_delta")
  quantity    Int             @default(1)
  // Был вариантом по умолчанию — бариста выделяет только отличия.
  isDefault   Boolean         @default(false) @map("is_default")

  @@index([orderItemId])
  @@map("order_item_modifiers")
}
