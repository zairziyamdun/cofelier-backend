# Скопировать в .env и заполнить. Схема и проверка — src/config/env.ts.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cofelier:cofelier@localhost:5432/cofelier?schema=public
FRONTEND_URL=http://localhost:3000

# Подпись JWT: длинная случайная строка, своя на каждом окружении (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Срок жизни токена и cookie в секундах (7 дней).
JWT_TTL_SECONDS=604800
# Домен cookie в проде, если сайт и API на разных поддоменах: .cofelier.kz
COOKIE_DOMAIN=

# Первый админ: создаётся pnpm db:seed, если заданы обе переменные.
ADMIN_EMAIL=
ADMIN_PASSWORD=
