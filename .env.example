# Скопировать в .env и заполнить. Схема и проверка — src/config/env.ts.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cofelier:cofelier@localhost:5432/cofelier?schema=public
FRONTEND_URL=http://localhost:3000

# Подпись JWT: длинная случайная строка, своя на каждом окружении (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Срок жизни токена и cookie в секундах (7 дней).
JWT_TTL_SECONDS=604800
# Домен cookie в проде, если сайт и API на разных поддоменах: .cofelier.kz
COOKIE_DOMAIN=

# Сколько прокси перед API (X-Forwarded-For) — чтобы лимит входа считался по IP клиента.
# Локально через сайт (next dev) — 1; на Railway за сайтом Vercel — см. docs/DEPLOY.md.
TRUST_PROXY=0

# Первый админ: создаётся при старте API, если его ещё нет (admin-bootstrap.service.ts).
# Обе переменные вместе, пароль от 12 символов, иначе API не стартует.
# Существующий аккаунт не трогается; не-админа молча не повышает.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true — разово: этот аккаунт станет админом, включится, пароль — из ADMIN_PASSWORD.
# После входа убрать.
ADMIN_RESET_PASSWORD=
